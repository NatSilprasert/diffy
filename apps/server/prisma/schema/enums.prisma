// Values are lower-case on purpose: they are identical in the database, in the generated Prisma
// client, in the API and in @diffy/shared, so no mapping code is needed anywhere. A test keeps
// this file and @diffy/shared in sync.
enum LlmProvider {
  openai
  anthropic
  google
  openrouter
}

enum ReviewStatus {
  queued
  running
  posted
  failed
  skipped
}

enum Severity {
  critical
  high
  medium
  low
}

enum Placement {
  inline
  summary
}

# Used by `next dev` only. A production build leaves this unset and calls the API on its own origin.
# "localhost" and not 127.0.0.1: the session cookie is kept per host, and signing in with GitHub comes back to the
# address registered as the App's callback (http://localhost:4000/...), so the web app must use that same host.
# Open the web app at http://localhost:3000 for the same reason.
NEXT_PUBLIC_API_URL=http://localhost:4000

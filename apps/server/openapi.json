          "provider": {
            "type": "string",
            "enum": [
              "openai",
              "anthropic",
              "google",
              "openrouter"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "apiKey": {
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model"
        ]
      },
      "UpdateLlmSettingsResponseDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "openai",
              "anthropic",
              "google",
              "openrouter"
            ]
          },
          "model": {
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model"
        ]
      }

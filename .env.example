# --- Database (Supabase Postgres) --- used from step B2 on
# Runtime: transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Migrations: session pooler (port 5432, IPv4) or direct connection
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Local Supabase CLI instead (both the same):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# 32-byte key for encrypting API keys at rest. Generate: openssl rand -base64 32
# Changing it makes saved keys unreadable (re-enter them in Settings).
ENCRYPTION_KEY=""

# The one port serving the web app and the API (open http://localhost:3000). `pnpm dev` ignores this and
# runs the API on 4000, so that the web dev server can use 3000.
PORT=3000
HOST=127.0.0.1          # no auth in v1 - keep it on localhost

# The diffy GitHub App (see docs/PLAN.md, Phase S). diffy will not start without these three.
GITHUB_APP_ID=
# Path of the App's private key (.pem), relative to the project root or absolute. Keep the file out of git.
GITHUB_APP_PRIVATE_KEY_PATH=
# The secret GitHub signs webhooks with (at least 16 characters).
GITHUB_WEBHOOK_SECRET=

# Signing in with GitHub: the OAuth credentials of the same App (General page, "Client ID" and "Client secrets").
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where a browser reaches diffy's API: the address registered as the App's "Callback URL" is
# <PUBLIC_URL>/api/auth/github/callback. Defaults to http://localhost:PORT; https:// turns on Secure cookies.
# PUBLIC_URL=
# Where the web app is, for sending people back after they sign in. Defaults to PUBLIC_URL (`pnpm dev` sets it).
# WEB_URL=

# How much diff one review may send to the model, in characters (about 4 per token). Larger pull requests are
# reviewed in part: code first, then tests, then other files. More is more thorough, slower and costs more.
MAX_DIFF_CHARS=150000

# Show the model the function around each change (and small files whole), not only the three lines GitHub gives.
# Same budget as MAX_DIFF_CHARS. Much better reviews; false sends the plain patches (cheaper, shallower).
EXPAND_DIFF_CONTEXT=true

# Before posting, ask the model to try to prove each finding wrong and drop the ones it cannot defend. Fewer false
# alarms; costs a second call that re-reads the code of the files with findings. false posts every finding.
VERIFY_FINDINGS=true

# How much of the project's own documents (README, AGENTS.md, CLAUDE.md, CONTRIBUTING.md, .cursorrules...) is added
# to every review, in characters. 0 turns it off. Costs about 1 token per 4 characters on every review.
MAX_CONTEXT_CHARS=30000

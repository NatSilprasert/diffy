      "UpdateLlmSettingsRequestDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "openai",
              "anthropic",
              "google",
              "openrouter"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "apiKey": {
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model"
        ]
      },
      "UpdateLlmSettingsResponseDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "openai",
              "anthropic",
              "google",
              "openrouter"
            ]
          },
          "model": {
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model"
        ]
      },
      "TestLlmSettingsResponseDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "latencyMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ok",
          "error",
          "latencyMs"
        ]

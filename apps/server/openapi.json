                "fullName": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "isPrivate": {
                  "type": "boolean"
                }
              },
              "required": [
                "fullName",
                "owner",
                "name",

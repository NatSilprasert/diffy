// How an account's pull requests are reviewed: which model, and the API key the account gave for it. One row per
// account. The key is stored encrypted, never in plain text.
model Settings {
  accountId    String       @id
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  llmProvider  LlmProvider?
  llmModel     String?
  llmApiKeyEnc String?
  updatedAt    DateTime     @updatedAt
}

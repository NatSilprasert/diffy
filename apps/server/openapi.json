    "schemas": {
      "GetHealthResponseDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "database": {
            "type": "string",
            "const": "up"
          }
        },
        "required": [
          "ok",
          "database"
        ]
      },
      "GetSettingsResponseDto": {
        "type": "object",
        "properties": {
          "github": {
            "type": "object",
            "properties": {
              "configured": {
                "type": "boolean"
              },
              "login": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "configured",
              "login"
            ]
          },
          "llm": {
            "type": "object",
            "properties": {
              "configured": {
                "type": "boolean"
              },
              "provider": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "openai",
                      "anthropic",
                      "google",
                      "openrouter"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "configured",
              "provider",
              "model"
            ]
          }
        },
        "required": [
          "github",
          "llm"
        ]
      },
      "UpdateGithubSettingsRequestDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1

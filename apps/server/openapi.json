                  "$ref": "#/components/schemas/UpdateRepoResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "No such repository"
          }
        },
        "tags": [
          "Repos"
        ]
      },
      "delete": {
        "operationId": "removeRepo",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed. Its review history is kept."
          },
          "404": {
            "description": "No such repository"
          }
        },
        "tags": [
          "Repos"
        ]
      }
    }

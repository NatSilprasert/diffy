{
  "name": "diffy",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @diffy/core... build && pnpm --parallel --filter @diffy/server --filter @diffy/web dev",
    "api:dev": "pnpm --filter @diffy/core... build && pnpm --filter @diffy/server dev",
    "web:dev": "pnpm --filter @diffy/web dev",
    "gen:api": "pnpm --filter @diffy/server gen:openapi && pnpm --filter @diffy/web gen:client",
    "db:up": "docker start diffy-db || docker run -d --name diffy-db -e POSTGRES_PASSWORD=postgres -p 127.0.0.1:54322:5432 -v diffy-db-data:/var/lib/postgresql/data postgres:17",
    "db:down": "docker stop diffy-db"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}

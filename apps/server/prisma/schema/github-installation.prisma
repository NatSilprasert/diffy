// A place where the diffy GitHub App is installed, and which of the account's repositories it was given (GitHub keeps
// that list; diffy reads it when needed). Created and kept up to date by GitHub's webhooks.
model GithubInstallation {
  id                  String    @id @default(cuid())
  // GitHub's own id of the installation.
  installationId      Int       @unique
  accountId           String
  account             Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // "all" repositories of the account, or only "selected" ones.
  repositorySelection String
  // Set while GitHub has the installation suspended; reviews must not run.
  suspendedAt         DateTime?
  // Set when the App was uninstalled. The row stays so the history that refers to it keeps its meaning.
  removedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
